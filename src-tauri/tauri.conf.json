{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tugboat",
  "version": "0.3.0",
  "identifier": "sh.brig.desktop",
  "build": {
    "beforeDevCommand": "npm run native:prepare && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run native:prepare && npm run build",
    "beforeBundleCommand": "npm run licenses:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Tugboat",
      "theme": "Dark",
      "width": 1020,
      "height": 700,
      "minWidth": 760,
      "minHeight": 500,
      "center": true,
      "maximized": true,
      "fullscreen": false,
      "create": false,
      "visible": false,
      "decorations": true,
      "titleBarStyle": "Visible",
      "devtools": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Agent Sandbox",
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": { "../resources/fonts/": "fonts/", "../.build/brig-runtime/build.json": "runtime/build.json", "../.build/brig-runtime/mke2fs.conf": "runtime/mke2fs.conf", "../.build/brig-runtime/registry/": "runtime/registry/" },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icons/Assets.car",
        "Resources/licenses": "../.build/licenses",
        "MacOS/brig": "../.build/brig-runtime/bin/brig",
        "MacOS/brigd": "../.build/brig-runtime/bin/brigd",
        "MacOS/brig-broker": "../.build/brig-runtime/bin/brig-broker",
        "MacOS/hull": "../.build/brig-runtime/bin/hull",
        "MacOS/hvi": "../.build/brig-runtime/bin/hvi",
        "MacOS/vz-runner": "../.build/brig-runtime/bin/vz-runner",
        "MacOS/cosign": "../.build/brig-runtime/bin/cosign",
        "MacOS/mke2fs": "../.build/brig-runtime/bin/mke2fs",
        "MacOS/debugfs": "../.build/brig-runtime/bin/debugfs",
        "MacOS/e2fsck": "../.build/brig-runtime/bin/e2fsck"
      }
    }
  }
}
