--- /dev/null
+++ b/cmd/hull/desktop_disktools.go
@@ -0,0 +1,31 @@
+//go:build darwin
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// diskTool resolves the private disk tools next to hull. A missing tool is an
+// incomplete application bundle and must never select a system replacement.
+func diskTool(name string) (string, error) {
+	executable, err := os.Executable()
+	if err != nil {
+		return "", fmt.Errorf("locate hull disk tools: %w", err)
+	}
+	return diskToolPath(executable, name)
+}
+
+func diskToolPath(executable, name string) (string, error) {
+	path := filepath.Join(filepath.Dir(executable), name)
+	information, err := os.Stat(path)
+	if err != nil {
+		return "", fmt.Errorf("bundled disk tool %s is unavailable: %w", name, err)
+	}
+	if !information.Mode().IsRegular() || information.Mode().Perm()&0111 == 0 {
+		return "", fmt.Errorf("bundled disk tool %s is not executable: %s", name, path)
+	}
+	return path, nil
+}
