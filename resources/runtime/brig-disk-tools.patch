+// Tugboat ships mke2fs beside brig and its patched hull. Resolve the actual
+// executable so a symlinked CLI still checks the matching bundled tool.
+// Keep a variable for the existing rootfs decision tests.
+var hullMke2fs = bundledMke2fs()
+
+func bundledMke2fs() string {
+	executable, err := os.Executable()
+	if err != nil {
+		return ""
+	}
+	if resolved, err := filepath.EvalSymlinks(executable); err == nil {
+		executable = resolved
+	}
+	return filepath.Join(filepath.Dir(executable), "mke2fs")
+}
 
 // hullOverlayRoot is whether hull can build an overlay root here: it can when
 // its mke2fs is there to run.
 func hullOverlayRoot() OverlayRoot {
 	if !isExecutable(hullMke2fs) {
-		return OverlayRoot{Why: "install e2fsprogs (brew install e2fsprogs): hull formats the disks with " + hullMke2fs}
+		return OverlayRoot{Why: "the bundled mke2fs is unavailable at " + hullMke2fs + "; reinstall Tugboat"}
 	}
 	return OverlayRoot{Available: true}
 }
