{
  "name": "tugboat",
  "description": "Agent Sandbox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "icon:build": "swift scripts/app-icon.swift .build/app-icon --update-bundle-assets",
    "native:prepare": "node scripts/prepare-ghostty.mjs && node scripts/prepare-hull.mjs",
    "test:terminal": "node scripts/test-terminal-engine.mjs",
    "test:hull": "node scripts/prepare-hull.mjs --test",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
